{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantumForge",
  "version": "0.4.0",
  "identifier": "org.quantumforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuantumForge",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8765; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "resources": {
      "../quantumforge": "backend/quantumforge",
      "../pyproject.toml": "backend/pyproject.toml",
      "../backend-dist/QuantumForgeBackend.exe": "backend/QuantumForgeBackend.exe"
    }
  }
}